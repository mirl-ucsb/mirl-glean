{
  // MIRL Glean image relay. Deploy from this folder with: npx wrangler deploy
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mirl-glean-relay",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // no request logs: the relay keeps no record of what it fetched
  "observability": { "enabled": false }
}
